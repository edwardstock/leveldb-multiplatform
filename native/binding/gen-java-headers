#!/bin/bash
set -euo pipefail

# path to the Kotlin-compiled .class output (so javac can resolve the types)
# if you build with Gradle, it’s usually under build/classes/kotlin/jvmShared/main
CLASSES_DIR=../../build/classes/kotlin/jvmShared/main

# where to dump generated headers
HEADERS_OUT=${PWD}

# fully qualified name of your class that contains native declarations
CLASS_NAME=com.edwardstock.leveldb.LevelDBNativeProvider

mkdir -p "$HEADERS_OUT"

javac -h "$HEADERS_OUT" -classpath "$CLASSES_DIR" "$CLASSES_DIR/${CLASS_NAME//.//}.class"
